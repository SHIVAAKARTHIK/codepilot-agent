# --- LLM ---
# "openai" or "anthropic" - selects which key below is used to build every
# agent's model (Orchestrator, Coder, Test Agent all share one provider).
LLM_PROVIDER=openai
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# Optional override - defaults to gpt-4o (openai) / claude-sonnet-5 (anthropic)
# CODEPILOT_MODEL=gpt-4o

# --- GitHub ---
# Personal access token with repo scope, used against the DEMO TARGET repo
# (the repo CodePilot operates on), not this repo.
GITHUB_TOKEN=
GITHUB_REPO=your-github-username/codepilot-demo-target

# --- Orchestrator ---
POLL_INTERVAL_MINUTES=5
COMPLEXITY_THRESHOLD=6

# --- Repo Explorer ---
REPO_MAP_TOKEN_BUDGET=4000
RETRIEVAL_TOP_K=10

# --- Coder ---
MAX_CODER_RETRIES=3
SANDBOX_ROOT=.codepilot_sandbox

# --- Memory ---
CHROMA_PERSIST_DIR=.codepilot_chroma
